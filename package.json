{
  "name": "trinkhallen-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "trinkhallen.app — Rust/Dioxus on Cloudflare Workers for finding German Trinkhallen / Spätis / Wasserhäuschen",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "bash scripts/build-dioxus.sh",
    "dev": "wrangler dev",
    "prepare": "lefthook install",
    "test": "cargo test --workspace",
    "test:e2e": "playwright test",
    "lint": "biome check && cargo fmt --all --check",
    "lint:fix": "biome check --write && cargo fmt --all",
    "db:migrate:local": "wrangler d1 migrations apply trinkhallen-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply trinkhallen-prod --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@khmyznikov/pwa-install": "^0.6.3",
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "lefthook": "^2.1.8",
    "opening_hours": "^3.8.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.0",
    "wrangler": "^4.94.0"
  }
}
