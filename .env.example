# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# Production values go in `wrangler secret put <KEY>`.

# 32+ random bytes (`openssl rand -hex 32`) — signs session cookies
SESSION_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8787/auth/google/callback for local dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In — required for iOS wrapper; see setup steps in README.md:81-92.
# Leaving these blank makes /auth/apple return 503, fine for local dev not exercising Apple login.
APPLE_SIGN_IN_SERVICES_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# GitHub App for opening PRs against trinkhallen-data on user submissions
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Cloudflare Turnstile bot protection for magic link sign-in.
# Leaving TURNSTILE_SECRET_KEY empty disables the bot gate on /auth/magic (cannot test gate locally without a real key).
TURNSTILE_SECRET_KEY=

# Environment variables (configured in wrangler.toml [vars] in production)
# Public site origin used to build OAuth redirect URIs and absolute links
PUBLIC_ORIGIN=http://localhost:8787
# Public Turnstile sitekey
TURNSTILE_SITE_KEY=
# Verified Email Routing destination for new-report notifications; unset/empty disables report emails
REPORT_NOTIFY_TO=
